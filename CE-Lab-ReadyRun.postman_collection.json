    {
      "name": "03-Extension",
      "item": [
        {
          "name": "01 POST echo run id",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "User-Agent",
                "value": "PostmanRuntime/7.44.0",
                "type": "text"
              }
            ],
            "url": "{{echo_url}}/post",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"runId\": \"{{run_id}}\",\n  \"student\": \"CE-demo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set(\"run_id\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "console.log(\"run_id:\", pm.variables.get(\"run_id\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Echo returns generated run id\", () => {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.json.runId).to.eql(pm.variables.get(\"run_id\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02 GET auth valid",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "User-Agent",
                "value": "PostmanRuntime/7.44.0",
                "type": "text"
              }
            ],
            "url": "{{echo_url}}/basic-auth",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "postman",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "password",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Valid credentials return 200\", () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"User is authenticated\", () => {",
                  "  pm.expect(pm.response.json().authenticated).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "03 GET auth missing",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "User-Agent",
                "value": "PostmanRuntime/7.44.0",
