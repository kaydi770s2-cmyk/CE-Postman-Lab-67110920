              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Missing credentials return 401\", () => {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.variables.set(\"base_url\", \"https://jsonplaceholder.typicode.com\");",
          "pm.variables.set(\"echo_url\", \"https://postman-echo.com\");",
          "pm.variables.set(\"user_id\", \"1\");"
        ]
      }
    }
  ]
}